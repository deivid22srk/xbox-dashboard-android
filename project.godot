; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="SeriesDash"
config/description="Dashboard estilo console (Xbox Series S) para Android, com loja de jogos e instalacao real de APK."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4")
boot_splash/bg_color=Color(0.043, 0.043, 0.045, 1)
boot_splash/show_image=false
config/icon="res://icon_512.png"

[autoload]

GameState="*res://scripts/GameState.gd"
Sfx="*res://scripts/Sfx.gd"
QA="*res://scripts/Qa.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input]

menu_guide={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":5,"pressure":0.0,"pressed":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":71,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
nav_shoulder_l={
